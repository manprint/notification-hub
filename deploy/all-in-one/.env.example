# NotifyHub all-in-one - configurazione del container unico.
#
#   cp .env.example .env
#
# Tutte le variabili sono opzionali. Lasciando vuoti i segreti, il container li
# genera al primo avvio e li persiste in /data/config/secrets.env: dal secondo
# avvio in poi riusa quelli. Se invece li si valorizza qui, l'ambiente ha la
# precedenza e le password dei ruoli PostgreSQL vengono riallineate a ogni
# avvio, quindi cambiarle e' sicuro.

# ---------------------------------------------------------------------------
# rete e host
# ---------------------------------------------------------------------------
# Porta pubblicata sull'host: e' l'unico ingresso (SPA + /api/v1 + /ingest).
HTTP_PORT=80
TZ=Europe/Rome

# URL con cui gli utenti raggiungono l'istanza: finisce nei link delle email
# di invito e nelle notifiche inoltrate.
NOTIFYHUB_PUBLIC_BASE_URL=http://localhost

# ---------------------------------------------------------------------------
# segreti (vuoti = generati e persistiti in /data/config/secrets.env)
# ---------------------------------------------------------------------------
# Almeno 32 caratteri. Cambiarlo invalida access e refresh token esistenti.
NOTIFYHUB_SECRET_KEY=
POSTGRES_SUPERUSER_PASSWORD=
PG_OWNER_PASSWORD=
PG_APP_PASSWORD=
PG_AUTH_PASSWORD=
PG_INGEST_PASSWORD=
NOTIFYHUB_S3_ACCESS_KEY=
NOTIFYHUB_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# primo tenant
#
# Se NOTIFYHUB_BOOTSTRAP_EMAIL e' valorizzata e il database non ha ancora
# tenant, il container crea tenant e utente owner al primo avvio. Senza
# password ne genera una e la scrive in /data/config/bootstrap-credentials.txt.
# ---------------------------------------------------------------------------
NOTIFYHUB_BOOTSTRAP_EMAIL=admin
NOTIFYHUB_BOOTSTRAP_PASSWORD=password
NOTIFYHUB_BOOTSTRAP_TENANT=NotifyHub

# ---------------------------------------------------------------------------
# applicazione
# ---------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=false
NOTIFYHUB_WEBHOOK_HOST_ALLOWLIST=hooks.slack.com,chat.googleapis.com
NOTIFYHUB_INLINE_MAX_BYTES=1048576
NOTIFYHUB_HARD_MAX_BODY_BYTES=20971520
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# SPA e API sono sulla stessa origine dietro nginx: serve solo se si usa l'API
# da un altro dominio.
CORS_ORIGINS=
# Reti dei proxy davanti al container, per fidarsi di X-Forwarded-For.
TRUSTED_PROXIES=
LOG_LEVEL=INFO

# Invio email (inviti). Vuoto = funzione disattivata.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# dimensionamento dei processi interni
# ---------------------------------------------------------------------------
UVICORN_WORKERS=2
WORKER_CONCURRENCY=4
# 127.0.0.1 = raggiungibile solo dentro al container. Mettere 0.0.0.0 solo se
# si pubblica la porta 9100 per uno scraper Prometheus esterno.
METRICS_BIND=127.0.0.1
# Come sopra per l'API S3 di MinIO (porta 9000).
MINIO_BIND=127.0.0.1
REDIS_APPENDONLY=yes

# PostgreSQL: valori validi per un'istanza piccola, da alzare con la RAM.
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_LOG_MIN_DURATION=1000

# ---------------------------------------------------------------------------
# log
# ---------------------------------------------------------------------------
# Rotazione dei file in /logs/<servizio>/. Lo stream di docker logs non e'
# toccato dalla rotazione.
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5

# ---------------------------------------------------------------------------
# aggiornamenti
# ---------------------------------------------------------------------------
# Dump automatico del database prima di ogni cambio di versione dell'immagine.
NOTIFYHUB_BACKUP_ON_UPGRADE=true
NOTIFYHUB_BACKUP_KEEP=5
# Bloccato per default: avviare una versione piu' vecchia su dati piu' recenti
# puo' trovare uno schema che non conosce.
ALLOW_DOWNGRADE=false
# on-upgrade | always: quando riallineare i preset di severity dei tenant.
NOTIFYHUB_SYNC_PRESETS=on-upgrade
# Ping reale al worker Celery dentro l'healthcheck.
NOTIFYHUB_HEALTHCHECK_CELERY=true
